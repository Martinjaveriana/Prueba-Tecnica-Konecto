# Copy this file to .env. Every value below except the API key has a working default.

# PostgreSQL (docker-compose)
POSTGRES_USER=konecto
POSTGRES_PASSWORD=konecto
POSTGRES_DB=series76
# Port on your machine. 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_PORT=5433

# Connection string used when running the backend outside Docker.
DATABASE_URL=postgresql://konecto:konecto@localhost:5433/series76

# OpenRouter: the agent needs it to answer questions. Never commit a real key.
OPENROUTER_API_KEY=your-openrouter-key-here
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_MAX_TOKENS=3000

# Port of the backend API on your machine.
BACKEND_PORT=8000

# Google AI Studio: only needed to re-run the data audit (ingest.py --audit).
GOOGLE_API_KEY=your-google-ai-studio-key-here
AUDIT_MODEL=gemini-3.5-flash